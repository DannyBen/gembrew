class ExampleCli < Formula
  desc "Example CLI"
  homepage "https://example.com"
  url "https://github.com/bashly-framework/bashly/archive/refs/tags/v1.2.3.tar.gz"
  sha256 "root-checksum"
  license "MIT"

  depends_on "ruby"

  uses_from_macos "libffi"

  on_macos do
    depends_on "bash"
  end

  resource "dependency" do
    url "https://rubygems.org/downloads/dependency-2.0.0.gem"
    sha256 "dependency-checksum"
  end

  def install
    ENV["GEM_HOME"] = libexec

    resources.each do |resource|
      system "gem", "install", resource.cached_download,
        "--ignore-dependencies", "--install-dir", libexec, "--no-document"
    end

    system "gem", "build", "example_cli.gemspec"
    system "gem", "install", "--ignore-dependencies", "example_cli-#{version}.gem",
      "--install-dir", libexec, "--no-document"

    (bin/"example").write_env_script libexec/"bin/example", GEM_HOME: ENV.fetch("GEM_HOME")

    rm libexec.glob("extensions/*/*/*/mkmf.log")

    deuniversalize_machos if OS.mac?
  end

  test do
    system bin/"example", "--version"
  end
end
